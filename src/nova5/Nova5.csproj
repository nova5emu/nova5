<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Nova5</AssemblyName>
    <RootNamespace>Nova5</RootNamespace>
    <ApplicationIcon>Assets\nova5.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Nova5</Product>
    <Copyright>GPL-2.0-or-later. Based on KytyPS5.</Copyright>
    <!-- One executable next to Nova5Emulator.exe that carries its own .NET runtime, so any PC can run it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

  <!-- SkiaSharp and HarfBuzz ship 100 MB of native symbols that the launcher does not need. -->
  <Target Name="DropNativeSymbols" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)libHarfBuzzSharp.pdb" />
  </Target>

</Project>
